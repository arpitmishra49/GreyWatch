# Copy this file to .env and fill in real values.
# See SETUP.md for exactly where each of these comes from.

# --- Grafana (sandbox) ---
# Base URL of the local Grafana container from docker-compose.yml.
GRAFANA_BASE_URL=http://localhost:3001
# Service account token (Viewer role is enough) created in Grafana's UI.
GRAFANA_API_TOKEN=

# --- Slack (sandbox) ---
# Bot token (starts with xoxb-) from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=
# Channel ID (not name) of the channel L3 alerts get posted to.
L3_CHANNEL_ID=

# --- App ---
DATABASE_URL="file:./dev.db"
PORT=3000

# --- Auth (shared account, seeded by prisma/seed.ts) ---
# Never used directly by the app at runtime — only read once at seed time
# to create/update the hashed password. Change and re-run `npm run db:seed`
# to rotate it.
CAN_ENGINEER_USERNAME=can.engineer
CAN_ENGINEER_PASSWORD=

# --- Email ---
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank to use the sandbox's fake-SMTP
# provider (Ethereal — nothing really sent, preview links only). Fill them
# in to send real email. For Gmail: SMTP_USER is your full Gmail address,
# SMTP_PASS is an App Password (NOT your normal password) — see SETUP.md
# for exactly how to generate one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender. For Gmail this should generally match SMTP_USER —
# Gmail will reject/flag mail sent "from" an address you don't own.
EMAIL_FROM=
