# Copy this file to .env and fill in real values.
# See SETUP.md for exactly where each of these comes from.

# --- Grafana (sandbox) ---
# Base URL of the local Grafana container from docker-compose.yml.
GRAFANA_BASE_URL=http://localhost:3001
# Service account token (Viewer role is enough) created in Grafana's UI.
GRAFANA_API_TOKEN=

# --- Slack (sandbox) ---
# Bot token (starts with xoxb-) from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=
# Channel ID (not name) of the channel L3 alerts get posted to.
L3_CHANNEL_ID=

# --- App ---
DATABASE_URL="file:./dev.db"
PORT=3000
